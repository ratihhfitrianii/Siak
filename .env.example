# ===== Siak — Environment Variables (Development) =====
# Salin ke .env lalu sesuaikan. JANGAN commit .env (S-04).
# Nilai di bawah hanya untuk development lokal; production memakai infra/.env.production.example.

# --- Backend ---
NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose -f infra/docker-compose.yml — host port default 5433)
POSTGRES_DB=siak
POSTGRES_USER=siak
POSTGRES_PASSWORD=siak_dev_password
DATABASE_URL=postgres://siak:siak_dev_password@localhost:5433/siak

# Redis (docker compose -f infra/docker-compose.yml — host port default 6380)
REDIS_URL=redis://localhost:6380

# Auth (T1.3) — placeholder, jangan dipakai production
JWT_SECRET=dev-only-please-change-this-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_TIMEOUT_MS=900000

# Rate limit (T1.3)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Waiting room (T1.13) — DL-11: default 5.000, configurable
WAITING_ROOM_THRESHOLD=2000

# Notifikasi (Iterasi 2+)
NOTIFICATION_PROVIDER=inapp

# CORS (frontend dev)
CORS_ORIGIN=http://localhost:5173
