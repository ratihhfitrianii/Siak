# Production Environment Variables (T1.15) — template untuk staging/production
# Copy ke .env.prod dan isi nilai nyata (JANGAN commit .env.prod!)
# Usage: docker compose -f infra/docker-compose.prod.yml --env-file .env.prod up -d --build

# Database
POSTGRES_DB=siak
POSTGRES_USER=siak
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# DATABASE_URL will be constructed from above: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=https://siak.yourdomain.com

# Waiting Room (DL-11, kalibrasi dari load test T1.14)
WAITING_ROOM_THRESHOLD=2000

# Database Pool (DL-28, kalibrasi dari load test T1.14)
# Staging: 100-200, Production VPS: 200-300
DATABASE_POOL_MAX=200

# Notification Provider (inapp | email | push)
NOTIFICATION_PROVIDER=inapp

# SSL Certificates (Let's Encrypt path in nginx-certs volume)
# Generate with: certbot certonly --standalone -d siak.yourdomain.com
# Then copy fullchain.pem + privkey.pem to ./certs/ (mounted to nginx-certs volume)
SSL_CERT=/etc/nginx/certs/fullchain.pem
SSL_KEY=/etc/nginx/certs/privkey.pem