# Staging Environment Variables (T1.15) — actual values for staging
# Usage: docker compose -f infra/docker-compose.prod.yml --env-file .env.staging up -d --build

# Database
POSTGRES_DB=siak
POSTGRES_USER=siak
POSTGRES_PASSWORD=StagingStrongPass2024!
# DATABASE_URL constructed: postgres://siak:StagingStrongPass2024!@postgres:5432/siak

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=StagingJWTSecretAtLeast32CharsRandom123456
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=https://localhost

# Waiting Room (DL-11, kalibrasi dari load test T1.14) - staging threshold 1500
WAITING_ROOM_THRESHOLD=1500

# Database Pool (DL-28, kalibrasi dari load test T1.14) - staging 100-200
DATABASE_POOL_MAX=100

# Notification Provider (inapp | email | push)
NOTIFICATION_PROVIDER=inapp

# SSL Certificates (self-signed for staging)
SSL_CERT=/etc/nginx/certs/fullchain.pem
SSL_KEY=/etc/nginx/certs/privkey.pem