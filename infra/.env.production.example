# ===== Siak — Environment Variables (PRODUCTION) =====
# Salin ke infra/.env.production lalu isi nilai nyata di server.
# JANGAN commit file ini dengan nilai asli (S-04) — hanya placeholder di repo.

NODE_ENV=production

# PostgreSQL
POSTGRES_DB=siak
POSTGRES_USER=siak
POSTGRES_PASSWORD=<ganti-dengan-password-kuat>
# DATABASE_URL dibentuk otomatis di compose dari 3 var di atas (via pgbouncer:6432)

# Redis (tidak butuh password di compose ini; gunakan Redis dengan auth di produksi nyata)
# REDIS_PASSWORD=<ganti-bila-menggunakan-redis-auth>

# Auth — WAJIB diganti: 64 karakter acak
JWT_SECRET=<64-char-random>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_TIMEOUT_MS=900000

# Rate limit & waiting room (DL-11)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
WAITING_ROOM_THRESHOLD=5000

# CORS — asal frontend production
CORS_ORIGIN=https://siak.kampus.ac.id

# Notifikasi (Iterasi 2+; email membutuhkan SMTP_* — ditambahkan saat T2.5)
NOTIFICATION_PROVIDER=inapp

# Grafana (ubah dari default!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<ganti-dengan-password-kuat>
