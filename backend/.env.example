# ===== Backend Siak — Environment Variables =====
# Salin ke backend/.env (dev) — JANGAN commit (S-04).
# Nilai production: lihat infra/.env.production.example.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://siak:siak_dev_password@localhost:5433/siak
REDIS_URL=redis://localhost:6380
JWT_SECRET=dev-only-please-change-this-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_TIMEOUT_MS=900000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
WAITING_ROOM_THRESHOLD=5000
NOTIFICATION_PROVIDER=inapp
CORS_ORIGIN=http://localhost:5173
