{
  "name": "@siak/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Siak — Sistem Informasi Akademik (backend, monolith modular)",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').mkdirSync('dist/modules/waiting-room',{recursive:true});require('fs').copyFileSync('src/modules/waiting-room/waiting-room.lua','dist/modules/waiting-room/waiting-room.lua')\"",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
