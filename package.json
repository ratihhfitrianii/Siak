{
  "name": "siak",
  "version": "0.1.0",
  "private": true,
  "description": "Siak — Sistem Informasi Akademik (monorepo: frontend + backend)",
  "license": "Apache-2.0",
  "author": "Ratih Fitriani",
  "repository": {
    "type": "git",
    "url": "https://github.com/ratihhfitrianii/Siak.git"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspaces",
    "build:backend": "npm ci --workspaces --include-workspace-root && npm run build --workspace=backend",
    "build:frontend": "npm ci --workspaces --include-workspace-root && npm run build --workspace=frontend",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  },
  "auditConfig": {
    "ignore": [
      "GHSA-5j98-mcp5-4vw2",
      "GHSA-34x7-hfp2-rc4v",
      "GHSA-8qq5-rm4j-mr97",
      "GHSA-83g3-92jg-28cx",
      "GHSA-qffp-2rhf-9h96",
      "GHSA-9ppj-qmqm-q256",
      "GHSA-r6q2-hw4h-h46w",
      "GHSA-vmf3-w455-68vh",
      "GHSA-w8wr-v893-vjvp",
      "GHSA-23hp-3jrh-7fpw",
      "GHSA-8x88-c5mf-7j5w",
      "GHSA-gvwx-54wh-qm9j",
      "GHSA-r292-9mhp-454m",
      "GHSA-w5hq-g745-h8pq"
    ]
  }
}