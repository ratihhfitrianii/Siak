{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm ci --legacy-peer-deps",
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "https://siak-backend.onrender.com/api/v1/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}