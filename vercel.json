{
  "buildCommand": "npm run build --workspace=frontend",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "installCommand": "npm ci --workspaces --legacy-peer-deps",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://siak-backend.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}